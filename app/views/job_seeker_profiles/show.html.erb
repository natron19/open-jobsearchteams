<div class="row justify-content-center">
  <div class="col-md-7">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h1 class="mb-0">My Profile</h1>
      <%= link_to "Edit", edit_profile_path, class: "btn btn-outline-secondary btn-sm" %>
    </div>

    <div class="card mb-4">
      <div class="card-body">
        <dl class="mb-0">
          <dt class="text-muted small">Current role</dt>
          <dd class="mb-3"><%= @profile.current_role %></dd>

          <dt class="text-muted small">Target role</dt>
          <dd class="mb-3"><%= @profile.target_role %></dd>

          <dt class="text-muted small">Top skills</dt>
          <dd class="mb-3"><%= @profile.top_skills %></dd>

          <dt class="text-muted small">Biggest challenge</dt>
          <dd class="mb-0"><%= @profile.biggest_challenge %></dd>
        </dl>
      </div>
    </div>

    <%= link_to "Analyze a new job →", new_advisor_session_path, class: "btn btn-primary" %>
  </div>
</div>
